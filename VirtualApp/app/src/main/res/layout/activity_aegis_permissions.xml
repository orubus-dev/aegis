<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F14"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aegis_perm_title"
            android:textColor="#FF3DDC84"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/aegis_perm_subtitle"
            android:textColor="#FF9AA4B0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/aegis_perm_sim_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FF151B23"
            android:padding="14dp"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/aegis_perm_apps_header"
        android:textColor="#FF5B6675"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/aegis_perm_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#FF1C242E"
        android:dividerHeight="1dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />
</LinearLayout>
