<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F14"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aegis_perm_sheet_title"
            android:textColor="#FF3DDC84"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aegis_app_perms_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FF9AA4B0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/aegis_perm_sheet_hint"
            android:textColor="#FF5B6675"
            android:textSize="11sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/aegis_app_perms_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#FF1C242E"
        android:dividerHeight="1dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />
</LinearLayout>
