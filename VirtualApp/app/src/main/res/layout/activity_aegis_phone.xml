<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F14"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aegis_phone_title"
            android:textColor="#FF3DDC84"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/aegis_phone_subtitle"
            android:textColor="#FF9AA4B0"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/aegis_phone_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="#FF151B23"
        android:gravity="center"
        android:minHeight="56dp"
        android:textColor="#FFE8ECF1"
        android:textSize="24sp"
        android:textStyle="bold" />

    <GridLayout
        android:id="@+id/aegis_phone_pad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:columnCount="3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/aegis_phone_call"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#FF173324"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/aegis_phone_call"
            android:textColor="#FF3DDC84"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aegis_phone_backspace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#FF151B23"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/aegis_phone_backspace"
            android:textColor="#FFE5704A"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:text="@string/aegis_phone_log_header"
        android:textColor="#FF5B6675"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/aegis_phone_log"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#FF1C242E"
        android:dividerHeight="1dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />
</LinearLayout>
