<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F14"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aegis_os_title"
                android:textColor="#FF3DDC84"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/aegis_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FF9AA4B0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/aegis_engine_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FF151B23"
            android:padding="12dp"
            android:textColor="#FF7FD1A7"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/aegis_section_apps"
                android:textColor="#FF5B6675"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aegis_row_apps"
                style="@style/AegisSettingsRow"
                android:text="@string/aegis_row_apps" />

            <TextView
                android:id="@+id/aegis_row_add_app"
                style="@style/AegisSettingsRow"
                android:text="@string/aegis_row_add_app" />

            <TextView
                android:id="@+id/aegis_row_add_apk"
                style="@style/AegisSettingsRow"
                android:text="@string/aegis_row_add_apk" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/aegis_section_privacy"
                android:textColor="#FF5B6675"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aegis_row_vault"
                style="@style/AegisSettingsRow"
                android:text="@string/aegis_row_vault" />

            <TextView
                android:id="@+id/aegis_row_camera"
                style="@style/AegisSettingsRow"
                android:text="@string/aegis_row_camera" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/aegis_section_system"
                android:textColor="#FF5B6675"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aegis_row_engine"
                style="@style/AegisSettingsRow"
                android:text="@string/aegis_row_engine" />

            <TextView
                android:id="@+id/aegis_row_about"
                style="@style/AegisSettingsRow"
                android:text="@string/aegis_row_about" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/aegis_footer"
                android:textColor="#FF45505C"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
