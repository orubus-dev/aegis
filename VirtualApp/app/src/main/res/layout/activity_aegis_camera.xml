<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <SurfaceView
            android:id="@+id/aegis_camera_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/aegis_camera_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#990B0F14"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/aegis_camera_hint"
            android:textColor="#FF9AA4B0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/aegis_camera_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="#FFE5704A"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF0B0F14"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/aegis_camera_system"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/aegis_camera_use_system"
            android:textColor="#FF9AA4B0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/aegis_camera_shutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/aegis_shutter_bg"
            android:gravity="center"
            android:text="@string/aegis_camera_shutter"
            android:textColor="#FF0B0F14"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aegis_camera_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/aegis_close"
            android:textColor="#FF9AA4B0"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
