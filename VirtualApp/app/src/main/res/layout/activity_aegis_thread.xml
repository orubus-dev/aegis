<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F14"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/aegis_thread_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF3DDC84"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aegis_thread_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FF9AA4B0"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/aegis_thread_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:stackFromBottom="true"
        android:transcriptMode="normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/aegis_thread_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#FF151B23"
            android:hint="@string/aegis_msg_hint"
            android:maxLines="4"
            android:padding="12dp"
            android:textColor="#FFE8ECF1"
            android:textColorHint="#FF5B6675"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/aegis_thread_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#FF173324"
            android:padding="14dp"
            android:text="@string/aegis_msg_send"
            android:textColor="#FF3DDC84"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
