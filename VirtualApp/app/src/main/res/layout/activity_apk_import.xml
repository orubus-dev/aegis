<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F14"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/apk_import_title"
        android:textColor="#FF3DDC84"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/apk_import_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#FF9AA4B0"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/apk_import_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/apk_import_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#FF7FD1A7"
        android:textSize="13sp" />

    <Button
        android:id="@+id/apk_import_pick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#FF151B23"
        android:text="@string/apk_import_pick"
        android:textColor="#FF3DDC84" />
</LinearLayout>
