<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F14"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/aegis_list_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF3DDC84"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aegis_list_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FF9AA4B0"
            android:textSize="13sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/aegis_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#FF1C242E"
        android:dividerHeight="1dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <TextView
        android:id="@+id/aegis_list_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#FF151B23"
        android:gravity="center"
        android:padding="14dp"
        android:textColor="#FF3DDC84"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
