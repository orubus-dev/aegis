<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F14"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vault_capture_title"
        android:textColor="#FF3DDC84"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/vault_capture_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#FF9AA4B0"
        android:textSize="13sp" />

    <Button
        android:id="@+id/vault_btn_photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#FF151B23"
        android:text="@string/vault_btn_photo"
        android:textColor="#FF3DDC84" />

    <Button
        android:id="@+id/vault_btn_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FF151B23"
        android:text="@string/vault_btn_video"
        android:textColor="#FF3DDC84" />
</LinearLayout>
